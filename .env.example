# ─────────────────────────────────────────────────────────────────────────────
# Shopee MCP — Environment Variables
#
# Unlike a plain scraper, this server drives a real Chromium profile so it can
# clear Shopee's anti-bot gate. You log in ONCE with `npm run login`; the session
# is saved to the profile dir below and reused. Everything here is optional.
# ─────────────────────────────────────────────────────────────────────────────

# Shopee regional domain (default: shopee.co.id)
# Also supported: shopee.com.my, shopee.sg, shopee.tw
SHOPEE_DOMAIN=shopee.co.id

# Optional browser locale/timezone overrides — both default from SHOPEE_DOMAIN's suffix:
#   .id  ->  id-ID / Asia/Jakarta      (also the fallback for any other domain)
#   .my  ->  en-MY / Asia/Kuala_Lumpur
#   .sg  ->  en-SG / Asia/Singapore
#   .tw  ->  zh-TW / Asia/Taipei
# SHOPEE_LOCALE=id-ID
# SHOPEE_TIMEZONE=Asia/Jakarta

# Where the persistent Chromium profile (your saved login) lives.
# Default: ~/.shopee-mcp/chrome-profile
# SHOPEE_PROFILE_DIR=/home/you/.shopee-mcp/chrome-profile

# The browser runs HEADED by default because Shopee detects headless — keep it
# that way. On a server, provide a virtual display via `xvfb-run`. Setting this
# to "true" is for experiments only and will almost certainly be blocked.
SHOPEE_HEADLESS=false

# EXPERIMENTAL account mode. "auto" (default): while the session is logged in,
# also offer tools for your own account — orders, vouchers, coins, notifications,
# cart edits, likes, follows, voucher claims (never checkout or payment).
# "off": always read-only.
# SHOPEE_ACCOUNT_TOOLS=auto

# Cache lifetime in milliseconds (default: 30000 = 30s)
CACHE_TTL_MS=30000

# Set to "true" to log startup/debug info to stderr
DEBUG=false

# ─── Docker / EasyPanel (see Dockerfile) ──────────────────────────────────────
# The image sets MCP_TRANSPORT=http and serves two things on MCP_PORT (8080):
#   /       browser UI (basic auth: UI_USER / UI_PASSWORD) for the one-time login
#   /mcp    MCP Streamable HTTP (Authorization: Bearer MCP_AUTH_TOKEN)
# Mount a volume at /data so the login survives redeploys.
# VNC_PASSWORD is the password typed inside the noVNC screen (max 8 characters).
# MCP_TRANSPORT=http
# MCP_PORT=8080
# MCP_AUTH_TOKEN=
# UI_USER=shopee
# UI_PASSWORD=
# VNC_PASSWORD=
# SHOPEE_PROFILE_DIR=/data/chrome-profile
